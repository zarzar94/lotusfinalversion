# Clinic phone number for WhatsApp integration (required)
# Format: +966XXXXXXXXX (Saudi Arabia format with country code)
VITE_CLINIC_PHONE=+966500000000

# Backend API URL (required for user management and data persistence)
# Default: http://localhost:3001/api
VITE_API_URL=http://localhost:3001/api

# Enable offline mode fallback (stores data in localStorage when API unavailable)
VITE_ENABLE_OFFLINE_MODE=true

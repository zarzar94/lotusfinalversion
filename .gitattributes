# Default to text normalization; enforce LF where practical
* text=auto

# Force LF for source and config
*.js   text eol=lf
*.ts   text eol=lf
*.jsx  text eol=lf
*.tsx  text eol=lf
*.mjs  text eol=lf
*.json text eol=lf
*.css  text eol=lf
*.scss text eol=lf
*.html text eol=lf
*.md   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.tsconfig text eol=lf

# Treat binaries as-is
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.ico  binary
*.pdf  binary
*.pptx binary
*.zip  binary
*.mp3  binary
*.wav  binary
*.mp4  binary
*.webm binary
*.ttf  binary
*.otf  binary
*.woff binary
*.woff2 binary
